# Configuration precedence: command flags > process environment > this file > defaults.
NEWS_LIBRARY_BIND=127.0.0.1:8787
NEWS_LIBRARY_DATA=data
NEWS_LIBRARY_FETCH_TIMEOUT=30s
NEWS_LIBRARY_DIGEST_TIMEOUT=300s
NEWS_LIBRARY_LEASE=1m
NEWS_LIBRARY_BACKOFF=10s
NEWS_LIBRARY_ATTEMPTS=3
NEWS_LIBRARY_MAX_BYTES=4194304
NEWS_LIBRARY_DIGEST_MAX_BYTES=163840
NEWS_LIBRARY_CACHE_TTL=24h
NEWS_LIBRARY_NO_WORKER=false
NEWS_LIBRARY_NO_DIGESTS=false
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma4:cloud
# Optional for gateways requiring a key; never commit real credentials.
# OLLAMA_API_KEY=
# Current interests; empty disables interest prediction without disabling digests.
NEWS_LIBRARY_INTERESTS=
# Rules match case-insensitive literal substrings. Same reason = one cause (max p).
# Example: '[{"id":"ads","reason":"advertising","field":"url","contains":"/ads/","probability":0.95}]'
NEWS_LIBRARY_FILTER_RULES='[]'
NEWS_LIBRARY_FILTER_THRESHOLD=0.8
NEWS_LIBRARY_CHUNK_MAX_PARTS=64
NEWS_LIBRARY_CACHE_MAX_BYTES=536870912
NEWS_LIBRARY_CACHE_RETENTION=168h
NEWS_LIBRARY_CACHE_CLEANUP_INTERVAL=1h

# M3: local bge-m3 only; no generation calls for indexing/search.
NEWS_LIBRARY_EMBEDDINGS=false
NEWS_LIBRARY_EMBED_URL=http://localhost:11434/api/embed
NEWS_LIBRARY_EMBED_TIMEOUT=30s
# At least 32 random non-whitespace bytes; empty disables read API.
NEWS_LIBRARY_READ_TOKEN=

# M4 Telegram: secrets only here locally, never in Git or chat.
NEWS_LIBRARY_TELEGRAM_ENABLED=false
NEWS_LIBRARY_TELEGRAM_BOT_TOKEN=
NEWS_LIBRARY_TELEGRAM_CHAT_ID=
NEWS_LIBRARY_TELEGRAM_DAILY=
NEWS_LIBRARY_TELEGRAM_SIZE=5
# Optional metadata-only YouTube fallback; empty disables. Install yt-dlp separately.
NEWS_LIBRARY_YT_DLP=yt-dlp
NEWS_LIBRARY_YOUTUBE_LANGUAGES=uk,en
